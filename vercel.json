{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": { "preview": false } },
  "buildCommand": "npm run test:runtime && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/legal/privacy/?", "status": 308, "headers": { "Location": "/privacy" } },
    { "src": "/legal/terms/?", "status": 308, "headers": { "Location": "/terms" } },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index"
    },
    {
      "src": "/(?:dashboard|settings|support/inbox|alerts/(?:new|[^/]+/edit)|login|register|forgot-password|unsubscribe)/?",
      "headers": { "X-Robots-Tag": "noindex, nofollow" },
      "continue": true
    },
    {
      "src": "/sw.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(charts|planner|privacy|terms|rates/(?:nzd-inr|aud-inr|usd-inr|gbp-inr|eur-inr|nzd-usd)|legal/disclaimer)/?",
      "dest": "/$1.html"
    },
    { "src": "/", "dest": "/index.html" },
    {
      "src": "/(?:dashboard|settings|support/inbox|alerts/(?:new|[^/]+/edit)|login|register|forgot-password|unsubscribe)/?",
      "dest": "/app-shell.html"
    },
    { "src": "/.*", "status": 404, "dest": "/app-shell.html" }
  ],
  "installCommand": "npm ci"
}
