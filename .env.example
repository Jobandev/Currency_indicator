PORT=3001
APP_URL=http://localhost:5173
CRON_SECRET=
FIREBASE_PROJECT_ID=
# Server only. Prefer application default credentials on cloud hosting.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set to gmail or resend to enable email notifications.
EMAIL_PROVIDER=off
GMAIL_USER=ratewatch510@gmail.com
# Google App Password, never your normal Google password. Server only.
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=Ratewatch <alerts@your-verified-domain.com>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=
USE_EMULATORS=false
VITE_USE_EMULATORS=false

# Alternative to inline Admin JSON: absolute path to your private downloaded key.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional delayed intraday observations. The monitor polls once per interval.
EXCHANGERATE_DEV_API_KEY=
# Use the provider?s delayed anonymous feed when no API key is set.
EXCHANGERATE_DEV_KEYLESS=false
RATE_MONITOR_INTERVAL_MINUTES=30

# Firebase web push public configuration.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Required to enable scheduled summaries and signed unsubscribe links.
DIGEST_SECRET=
